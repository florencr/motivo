// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SellerType {
  PRIVATE
  DEALER
}

enum UserRole {
  ADMIN
  DEALER
  PRIVATE_SELLER
  BUYER
}

enum Currency {
  EUR
  ALL
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum DriveTrain {
  FWD
  RWD
  AWD
}

enum FooterSection {
  GET_STARTED
  USER_LINKS
  COMPANY
  APP
}

model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  phone           String?
  avatarUrl       String?
  passwordHash    String?
  role            UserRole   @default(BUYER)
  sellerType      SellerType?
  companyName     String?
  companyLogoUrl  String?
  taxId           String?
  dealerLicenseNo String?
  address         String?
  isVerified      Boolean    @default(false)
  isActive        Boolean    @default(true)
  listings        Listing[]
  sessions        UserSession[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([role])
  @@index([sellerType])
}

model UserSession {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String   @unique
  refreshTokenHash String?
  userAgent      String?
  ipAddress      String?
  expiresAt      DateTime
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Make {
  id         String          @id @default(cuid())
  name       String          @unique
  slug       String          @unique
  categoryId String?
  category   VehicleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  models     Model[]
  listings   Listing[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([categoryId])
}

model VehicleCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  makes     Make[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Model {
  id          String       @id @default(cuid())
  makeId      String
  make        Make         @relation(fields: [makeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  generations Generation[]
  listings    Listing[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([makeId, slug])
}

model Generation {
  id        String    @id @default(cuid())
  modelId   String
  model     Model     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  code      String
  slug      String
  listings  Listing[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([modelId, slug])
}

model Listing {
  id           String      @id @default(cuid())
  title        String
  slug         String      @unique
  sellerId     String
  seller       User        @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  makeName     String
  modelName    String
  generationName String?
  trim         String?
  price        Decimal     @db.Decimal(12, 2)
  currency     Currency
  year         Int
  mileageKm    Int
  sellerType   SellerType
  hasAlbanianPlates Boolean @default(false)
  isCustomsPaid Boolean @default(false)
  isTaxRefundable Boolean @default(false)
  fuelType     FuelType
  transmission Transmission
  engineCapacity Int?
  powerHp      Int?
  driveTrain   DriveTrain?
  color        String?
  city         String?
  description  String
  features     Json?
  isPublished  Boolean     @default(false)
  makeId       String
  modelId      String
  generationId String?
  make         Make        @relation(fields: [makeId], references: [id], onDelete: Restrict)
  model        Model       @relation(fields: [modelId], references: [id], onDelete: Restrict)
  generation   Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([price])
  @@index([year])
  @@index([mileageKm])
  @@index([fuelType])
  @@index([transmission])
  @@index([city])
  @@index([sellerId])
  @@index([makeId, modelId, generationId])
}

model FooterPage {
  id          String        @id @default(cuid())
  section     FooterSection
  title       String
  slug        String        @unique
  content     String
  isPublished Boolean       @default(false)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([section])
  @@index([isPublished])
}
