// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SellerType {
  PRIVATE
  DEALER
}

enum UserRole {
  ADMIN
  DEALER
  PRIVATE_SELLER
  BUYER
}

enum Currency {
  EUR
  ALL
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum DriveTrain {
  FWD
  RWD
  AWD
}

enum FooterSection {
  GET_STARTED
  USER_LINKS
  COMPANY
  APP
}

enum ImportSourceType {
  WEBSITE
  FACEBOOK_MARKETPLACE
  FACEBOOK_POST
  INSTAGRAM_POST
  MANUAL
}

enum ImportRunStatus {
  PENDING
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum ImportRecordStatus {
  CREATED
  UPDATED
  SKIPPED
  FAILED
}

model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  phone           String?
  avatarUrl       String?
  passwordHash    String?
  role            UserRole   @default(BUYER)
  sellerType      SellerType?
  companyName     String?
  companyLogoUrl  String?
  profileDescription String?
  taxId           String?
  dealerLicenseNo String?
  address           String?
  dealerRating      Float?
  dealerReviewCount Int        @default(0)
  isVerified        Boolean    @default(false)
  isActive          Boolean    @default(true)
  listings          Listing[]
  sessions        UserSession[]
  reviewsReceived SellerReview[] @relation("SellerReviewsReceived")
  reviewsGiven    SellerReview[] @relation("SellerReviewsGiven")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([role])
  @@index([sellerType])
}

model ListingTagOption {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model ListingFeatureOption {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model SellerReview {
  id                     String   @id @default(cuid())
  reviewerId             String
  reviewedUserId         String
  responsivenessRating   Int
  realityMatchRating     Int
  overallExperienceRating Int
  averageRating          Float
  comment                String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  reviewer     User @relation("SellerReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewedUser User @relation("SellerReviewsReceived", fields: [reviewedUserId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, reviewedUserId])
  @@index([reviewedUserId])
}

model UserSession {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String   @unique
  refreshTokenHash String?
  userAgent      String?
  ipAddress      String?
  expiresAt      DateTime
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model VehicleType {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  icon      String?
  sortOrder Int               @default(0)
  segments  VehicleSegment[]
  makes     Make[]
  createdAt DateTime          @default(now())
  updatedAt DateTime        @updatedAt

  @@index([sortOrder])
}

model VehicleSegment {
  id            String      @id @default(cuid())
  vehicleTypeId String
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  name          String
  slug          String
  icon          String?
  /** Optional image URL (https) shown instead of the built-in icon when set. */
  iconUrl       String?
  sortOrder     Int         @default(0)
  makes         Make[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([vehicleTypeId, slug])
  @@index([vehicleTypeId])
}

model Make {
  id            String          @id @default(cuid())
  name          String
  slug          String
  logoUrl       String?
  vehicleTypeId String
  vehicleType   VehicleType     @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)
  segmentId     String?
  segment       VehicleSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  models        Model[]
  listings      Listing[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([vehicleTypeId, slug])
  @@index([vehicleTypeId])
  @@index([segmentId])
}

model Model {
  id          String       @id @default(cuid())
  makeId      String
  make        Make         @relation(fields: [makeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  generations Generation[]
  listings    Listing[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([makeId, slug])
}

model Generation {
  id        String    @id @default(cuid())
  modelId   String
  model     Model     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  code      String
  slug      String
  listings  Listing[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([modelId, slug])
}

model Listing {
  id           String      @id @default(cuid())
  title        String
  slug         String      @unique
  sellerId     String
  seller       User        @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  makeName     String
  modelName    String
  generationName String?
  trim         String?
  price        Decimal     @db.Decimal(12, 2)
  currency     Currency
  year         Int
  mileageKm    Int
  sellerType   SellerType
  hasAlbanianPlates Boolean @default(false)
  isCustomsPaid Boolean @default(false)
  isTaxRefundable Boolean @default(false)
  fuelType     FuelType
  transmission Transmission
  engineCapacity Int?
  powerHp      Int?
  ownerCount   Int          @default(1)
  hasAccidentHistory Boolean @default(false)
  damageSeverity String?
  hasServiceHistory Boolean @default(false)
  driveTrain   DriveTrain?
  color        String?
  city         String?
  description  String
  features     Json?
  isPublished  Boolean     @default(false)
  makeId       String
  modelId      String
  generationId String?
  make         Make        @relation(fields: [makeId], references: [id], onDelete: Restrict)
  model        Model       @relation(fields: [modelId], references: [id], onDelete: Restrict)
  generation   Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([price])
  @@index([year])
  @@index([mileageKm])
  @@index([fuelType])
  @@index([transmission])
  @@index([city])
  @@index([sellerId])
  @@index([makeId, modelId, generationId])
}

model FooterPage {
  id          String        @id @default(cuid())
  section     FooterSection
  title       String
  slug        String        @unique
  content     String
  isPublished Boolean       @default(false)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([section])
  @@index([isPublished])
}

model ImportSource {
  id              String           @id @default(cuid())
  name            String
  type            ImportSourceType @default(WEBSITE)
  /** Connector key, e.g. "generic", "merrjep-vehicles". Maps to a connector module. */
  connectorKey    String           @default("generic")
  /** Origin URL like https://example.com (used to absolutize relative links). */
  baseUrl         String?
  /** JSON array of starting list URLs to crawl. */
  listUrls        Json
  /** Connector-specific config (selectors, headers, etc.). */
  config          Json?
  /** Email of the User to attach as the seller for imported listings. */
  defaultSellerEmail String
  defaultSellerType  SellerType    @default(DEALER)
  defaultCurrency    Currency      @default(EUR)
  /** Auto-publish listings as soon as they are valid. */
  autoPublish     Boolean          @default(true)
  requestDelayMs  Int              @default(1500)
  maxPerRun       Int              @default(100)
  isActive        Boolean          @default(true)
  lastRunAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  runs            ImportRun[]

  @@index([type])
  @@index([isActive])
}

model ImportRun {
  id            String            @id @default(cuid())
  sourceId      String
  source        ImportSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status        ImportRunStatus   @default(PENDING)
  startedAt     DateTime          @default(now())
  finishedAt    DateTime?
  createdCount  Int               @default(0)
  updatedCount  Int               @default(0)
  skippedCount  Int               @default(0)
  failedCount   Int               @default(0)
  /** Optional human-readable error message. */
  errorMessage  String?
  /** Free-form log entries for diagnostics. */
  logs          Json?
  records       ImportRecord[]

  @@index([sourceId])
  @@index([status])
  @@index([startedAt])
}

model ImportRecord {
  id           String             @id @default(cuid())
  runId        String
  run          ImportRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceUrl    String?
  externalId   String?
  status       ImportRecordStatus
  /** Listing slug if created/updated. */
  listingSlug  String?
  /** Why it was skipped or failed. */
  message      String?
  /** Snapshot of normalized record (for audit). */
  rawData      Json?
  createdAt    DateTime           @default(now())

  @@index([runId])
  @@index([status])
  @@index([listingSlug])
}
